 "_apa_ini": "Inference-distance ladder on the document channel, paired track of 96 rows, six models. Every rung uses the program label only, because the single-field control shows the semester alone nearly matches the full label. Its p values are stored with six decimals, so a p of 0.0 is below 0.0000005.",
 "kunci_buta_struktural": {
  "nilai": 48,
  "kenapa": "a scorer that does not read the profile returns identical rankings for the two rows of a pair, so exactly one row wins"
 },
 "anak_tangga": {
  "a": "[Source: <DEPT> degree program textbook], the same code as the instruction",
  "b": "[Source: <program name> degree program textbook], no shared token",
  "c": "Program studi <program name>., without the Source frame, exploratory",
  "d": "[Source: PRG-<nn> degree program textbook], opaque code, negative control"
 },
 "uji": "Exact paired McNemar, two-sided. Against rung a, to measure its collapse, and against the text-labeled cell without a profile, to test whether the cell can still be told apart from a blind scorer. Both are Holm-corrected within the family of six models. The paper does not test against 0.5, only against the key, and the blind cell is the key by construction.",
 "label_source": "deterministic (gold matching, no rater)",
