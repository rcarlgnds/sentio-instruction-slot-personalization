# Settings for the retrieval, scoring, and benchmark modules. Copy to system/.env and set your own
# values. The scripts that read them change to system/ first. None of them is a secret, and every other
# setting in app/config.py keeps its default.

# Vector store (BGE-M3 dense and sparse vectors of the corpus)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sentio_knowledge

# Embedding model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_FP16=true
EMBEDDING_BATCH_SIZE=12

# Program relations and course prerequisites for DITS. The DITS scripts read both from this database.
# system/data/department_relations.json records the program relations the study used.
DATABASE_URL=postgresql://localhost:5432/sentio

# Bounds of the similarity term. The study's bounds ship in system/calibration.json.
CALIBRATION_PATH=calibration.json

# The study's corpus was embedded with a breadcrumb prefix and no context prefix written by a language
# model. No released script reads this setting or adds such a prefix.
CONTEXTUAL_RETRIEVAL_ENABLED=false
